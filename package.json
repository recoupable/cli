{
  "name": "@recoupable/cli",
  "version": "0.1.20",
  "description": "Command-line tool for Recoup, the AI agent platform for the music industry: artists, research, content and sandboxes from your terminal or agent.",
  "keywords": [
    "recoup",
    "recoupable",
    "music",
    "music-industry",
    "record-label",
    "artists",
    "music-marketing",
    "ai-agents",
    "cli"
  ],
  "homepage": "https://docs.recoupable.dev/cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recoupable/cli.git"
  },
  "bugs": {
    "url": "https://github.com/recoupable/cli/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "recoup": "./dist/bin.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "commander": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
